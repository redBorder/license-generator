{
  "name": "license-server",
  "version": "0.5.0",
  "description": "Server for demo licenses generation using a REST API",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "app": "node dist/app.js",
    "build": "tsc",
    "watch": "gulp watch",
    "test": "NODE_OPTIONS='--loader ts-node/esm --no-warnings' mocha src/test --recursive --bail",
    "docs": "spectacle api.yaml -t docs",
    "coverage": "nyc npm test",
    "coveralls": "nyc npm test && nyc report --reporter=text-lcov | coveralls"
  },
  "keywords": [
    "api",
    "license",
    "generator",
    "redBorder"
  ],
  "author": "Diego Fernández Barrera",
  "license": "AGPL-3.0",
  "overrides": {
    "config": "^3.3.9"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/chai-as-promised": "^7.1.5",
    "@types/mocha": "^9.1.0",
    "@types/sinon": "^10.0.11",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "coveralls": "^3.1.1",
    "istanbul": "^0.4.5",
    "mocha": "^9.2.2",
    "mocha-typescript": "^1.1.17",
    "nyc": "^15.1.0",
    "sinon": "^13.0.1",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/joi": "^17.2.3",
    "@types/log4js": "^2.3.5",
    "@types/node": "^22.0.0",
    "@types/ramda": "^0.30.0",
    "@types/swagger-express-mw": "^0.7.0",
    "@types/uuid": "^11.0.0",
    "base64-url": "^2.3.3",
    "config": "^3.3.9",
    "express": "^5.0.0",
    "gulp": "^4.0.2",
    "gulp-typescript": "^5.0.1",
    "joi": "^17.13.3",
    "log4js": "^6.9.1",
    "mysql2": "^3.9.7",
    "node-rsa": "^1.1.1",
    "ramda": "^0.30.1",
    "ramda-fantasy": "^0.8.0",
    "reflect-metadata": "^0.2.2",
    "swagger-express-mw": "^0.7.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.5.0",
    "uuid": "^11.0.0"
  },
  "nyc": {
    "include": [
      "src/api/**/*.ts"
    ],
    "exclude": [
      "src/test"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text-summary",
      "json",
      "html"
    ],
    "all": true
  }
}
