version: '2'

services:
  server:
    image: license-generator:0.5.0
    depends_on: 
      - mariadb
    ports:
      - 80:3000
    volumes:
      - ./license.json:/app/config/license.json
    environment:
      - DB_PASSWORD=redborder
      - PRIVATE_KEY=your-private-key

  mariadb:
    image: mariadb
    volumes:
      - ./mariadb/:/etc/mysql/conf.d
    environment:
      - MYSQL_DATABASE=licenses
      - MYSQL_ROOT_PASSWORD=redborder
